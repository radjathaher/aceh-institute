{
  "name": "aceh-institute",
  "private": true,
  "workspaces": [
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsgo --noEmit -p apps/web/tsconfig.json && tsgo --noEmit -p tools/paper-sync/tsconfig.json",
    "sync": "bun run --cwd tools/paper-sync build",
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "preview": "bun run --cwd apps/web preview"
  },
  "devDependencies": {
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.3.12"
}
