---
type Props = { right?: string };
const { right } = Astro.props;
---

<header class="site-header">
  <a class="wordmark" href="/">
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
      <path d="M12.5 2.2A7.2 7.2 0 1 0 12.5 15.8 5.6 5.6 0 1 1 12.5 2.2Z" fill="var(--color-red)"></path>
      <path d="M14.6 6.6l.7 1.5 1.6.2-1.2 1.1.3 1.6-1.4-.8-1.4.8.3-1.6-1.2-1.1 1.6-.2z" fill="var(--color-ink)"></path>
    </svg>
    <span>Aceh Institute</span>
  </a>
  <nav class="site-nav">
    <a href="/s/01/">Aceh 2045</a>
    <a href="/about/">About</a>
    {right && <span class="site-nav-right">{right}</span>}
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1600px;
    margin: 0 auto;
    padding: 20px 24px;
  }
  .wordmark {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 20px;
    letter-spacing: var(--tracking-tight);
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: 24px;
    font-size: 15px;
    font-weight: 500;
  }
  .site-nav-right {
    font-family: var(--font-mono);
    font-size: var(--text-source);
    letter-spacing: var(--tracking-wide);
    color: var(--color-muted);
  }
</style>
