---
import SiteLayout from "~/layouts/site-layout.astro";
import SiteHeader from "~/components/site-header.astro";
import DeckIndex from "~/components/deck-index.astro";
import { loadDecks, loadDeckSlides } from "~/common/load-decks";

const deck = loadDecks().find((entry) => entry.id === "cases")!;
const slides = loadDeckSlides(deck);
---

<SiteLayout title={`${deck.title} — Aceh Manifesto`} description={deck.description} canonical="/cases/">
  <SiteHeader />
  <DeckIndex deck={deck} slides={slides} />
</SiteLayout>
