---
import SiteLayout from "~/layouts/site-layout.astro";
import SiteHeader from "~/components/site-header.astro";
import SlideStage from "~/components/slide-stage.astro";
import SlideNav from "~/components/slide-nav.astro";
import { loadSlides } from "~/common/load-decks";

export function getStaticPaths() {
  return loadSlides().map((slide) => ({ params: { id: slide.id }, props: { slide } }));
}

const { slide } = Astro.props;
const title = slide.title ? `${slide.title} — Aceh Manifesto` : `Aceh Manifesto · ${slide.id}`;
const ogImage = slide.images[0] ?? "/img/cover-sabang-strait.png";
---

<SiteLayout
  title={title}
  description={slide.sourceLine || undefined}
  ogImage={ogImage}
  canonical={`/s/${slide.id}/`}
  prefetch={slide.next ? `/s/${slide.next}/` : undefined}
>
  <SiteHeader right={slide.section} />
  <main class="deck-main">
    <SlideStage html={slide.html} label={slide.title || slide.name} />
  </main>
  <SlideNav
    index={slide.index}
    total={slide.total}
    prev={slide.prev}
    next={slide.next}
    paperNodeId={slide.paperNodeId}
    deckTitle={slide.deckTitle}
    deckHref={slide.deckHref}
  />
</SiteLayout>

<style>
  .deck-main {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 24px;
  }
</style>
